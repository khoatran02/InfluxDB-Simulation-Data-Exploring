# Local classroom demo credentials; replace before sharing a network deployment.
# Setup variables apply only when initializing empty InfluxDB volumes.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin-password-123
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=agriculture
INFLUXDB_TOKEN=my-token
